// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Modèles existants (hérités du template shadcn) — non modifiés à l'exception
// de l'ajout de la relation `bets` sur User (suivi des paris utilisateurs).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // Mot de passe HACHÉ (bcrypt) — JAMAIS stocké en clair.
  // Ajouté pour l'authentification par compte (NextAuth CredentialsProvider).
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Relation inverse vers les paris de cet utilisateur (UserBet).
  bets      UserBet[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Modèles PronoBot — persistance des matchs, pronostics et paris utilisateurs
// ─────────────────────────────────────────────────────────────────────────────

// Compétition normalisée (référence ESPN). L'ID vient directement d'ESPN
// (ex: "eng.1" pour Premier League, "uefa.champions" pour la Ligue des Champions).
// On évite ainsi la duplication des chaînes "competition" dans chaque Match.
model Competition {
  id        String   @id // ID ESPN de la compétition (ex: "eng.1", "uefa.champions")
  name      String
  country   String?
  createdAt DateTime @default(now())
  matches   Match[]
}

// Équipe normalisée (référence ESPN). L'ID vient d'ESPN. `nameFr` permet de
// stocker une traduction française optionnelle (meilleur affichage UI).
model Team {
  id        String   @id // ID ESPN de l'équipe
  name      String
  nameFr    String?
  logo      String?
  createdAt DateTime @default(now())
  // Relations séparées pour éviter l'ambiguïté entre domicile et extérieur.
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

// Match — enregistrement historique d'une rencontre + score final.
// L'ID vient d'ESPN (event id). Les cotes au moment de la prédiction sont
// stockées en JSON textuel (SQLite n'a pas de type Json natif). Le statut
// permet de savoir si le match est planifié, en cours ou terminé.
model Match {
  id            String   @id // ID ESPN de l'événement (event id)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  homeTeamId    String
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    String
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  date          DateTime
  heure         String?
  status        String     @default("scheduled") // scheduled | live | finished
  scoreHome     Int?
  scoreAway     Int?
  // Cotes originales au moment de la prédiction (JSON textuel — SQLite n'a pas de type Json natif).
  cotesJson     String?
  oddsSource    String?    // draftkings | api_football | football_data | espn_predictor | form_based
  createdAt     DateTime   @default(now())
  pronostics    Pronostic[]
  userBets      UserBet[]

  @@index([competitionId, date])
  @@index([date])
}

// Pronostic — instantané (snapshot) d'un pronostic généré pour un match.
// `payloadJson` contient le payload complet (probas_1x2, double_chance, tous
// les paris possibles, expected_goals, etc.) en JSON textuel. Les champs
// `bestBet*` sont dénormalisés pour faciliter le filtrage et l'agrégation.
// `result` est renseigné lorsque le match est terminé (win | loss | void | pending).
// `onDelete: Cascade` : la suppression d'un match supprime ses pronostics.
model Pronostic {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  // Payload complet du pronostic (probas_1x2, double_chance, tous les paris, expected_goals, etc.).
  // Stocké en String car SQLite n'a pas de type Json natif.
  payloadJson  String
  // Champs dénormalisés pour faciliter le filtrage et l'agrégation.
  bestBetType  String?  // ex: "1X2", "Double Chance"
  bestBetProba Float?
  bestBetCote  Float?
  // Suivi du résultat (renseigné lorsque le match est terminé).
  result       String?  // win | loss | void | pending
  createdAt    DateTime @default(now())

  @@index([matchId])
  @@index([result])
  @@index([bestBetType, result])
}

// UserBet — suivi des paris d'un utilisateur (ce qu'il a parié + issue).
// On snapshot les infos du pari pour conserver l'historique même si le match
// est supprimé (onDelete: Restrict par défaut sur la relation Match).
// `onDelete: Cascade` sur User : la suppression d'un user supprime ses paris.
// `result` et `payout`/`profit` sont renseignés au règlement du match.
model UserBet {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id])
  // Snapshot du pari (survit même si le match est supprimé — onDelete: Restrict par défaut).
  betType      String   // "1X2", "Double Chance", "BTTS", etc.
  betSelection String   // ex: "Victoire France"
  betChoix     String   // ex: "1", "1N", "Oui"
  cote         Float
  stake        Float    // montant parié (dans la devise de l'utilisateur)
  // Résultat (renseigné au règlement du match).
  result       String   @default("pending") // pending | win | loss | void
  payout       Float?   // montant retourné (stake * cote si gain, 0 si perte, stake si void)
  profit       Float?   // payout - stake
  settledAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, result])
  @@index([matchId])
}
