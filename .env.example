# ─────────────────────────────────────────────────────────────────────────────
# PronoBot — variables d'environnement
# Copie ce fichier vers `.env` et remplis les valeurs.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# === BASE DE DONNÉES ===
# Dev (local) : SQLite
DATABASE_URL="file:./db/custom.db"
# Prod (Vercel) : passe sur Postgres/Neon →
# DATABASE_URL="postgresql://user:pass@host:port/db"

# === SOURCES DE COTES ===
# Football-Data.org (gratuit) → https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=""

# API-Football (gratuit, 100 req/jour) → https://www.api-football.com/
API_FOOTBALL_KEY=""

# === CACHE DISTRIBUÉ (REDIS UPSTASH — OPTIONNEL)
# Si laissé vide, l'app retombe sur un cache en mémoire (dev mono-instance).
# Pour la prod sur Vercel, crée une base Upstash Redis :
#   https://console.upstash.com → et copie les 2 valeurs ci-dessous.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# === MONITORING (OPTIONNEL) ===
# Activer Sentry seulement si tu as un projet Sentry.
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_TRACE_SAMPLE_RATE="1.0"

# === MODE ===
# NODE_ENV est géré par le runtime (dev/production). Ne pas forcer en prod manuellement.